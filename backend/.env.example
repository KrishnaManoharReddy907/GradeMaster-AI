# Copy to backend/.env and fill in. Never commit the real .env.

# development | production
APP_ENV=development
LOG_LEVEL=INFO

# MongoDB (local or Atlas: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=grademaster

# Required: random string of at least 32 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI (Gemini powers explanations, OCR mapping, manual grading, code feedback, question generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini            # gemini | ollama | none

# OCR (optional: without it Gemini vision transcribes handwriting)
GOOGLE_VISION_API_KEY=

# Code execution (public Judge0 CE works without a key; for RapidAPI set both key and host)
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=

# Optional local extras (see requirements-ml.txt)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
ENABLE_CODEBERT=false

# Upload limits
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=20
